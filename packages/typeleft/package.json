{
  "$schema": "https://json.schemastore.org/package",
  "name": "typeleft",
  "version": "0.0.0",
  "description": "Typedown: A typed content framework. Work in progress.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Huy-DNA/typedown.git",
    "directory": "packages/typedown"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist"
  ],
  "keywords": [
    "vite-plugin",
    "rolldown-plugin",
    "typedown"
  ],
  "author": "Huy-DNA <huydo862003@gmail.com>",
  "license": "AGPL-3.0-only",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json --emitDeclarationOnly",
    "lint": "eslint .",
    "lint:fix": "eslint ./src --fix",
    "test": "vitest"
  },
  "dependencies": {
    "@shikijs/markdown-it": "^4.3.1",
    "markdown-it": "^14.0.0",
    "markdown-it-anchor": "^9.0.0",
    "markdown-it-container": "^4.0.0",
    "markdown-it-emoji": "^3.0.0",
    "markdown-it-task-lists": "^2.1.1",
    "@typeright/rpc-client": "workspace:*",
    "@typeright/rpc-server": "workspace:*",
    "shiki": "^4.3.1"
  },
  "peerDependencies": {
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0",
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@hdnax/nuclint": "^0.17.4",
    "@types/markdown-it": "^14.0.0",
    "@types/markdown-it-container": "^4.0.0",
    "@types/markdown-it-emoji": "^3.0.1",
    "@types/node": "~24.13.3",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.5"
  }
}
